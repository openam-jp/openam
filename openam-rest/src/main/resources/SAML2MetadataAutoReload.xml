<ServicesConfiguration>
    <Service name="SAML2MetadataAutoReload" version="1.0">
        <Schema
            serviceHierarchy="/DSAMEConfig/SAML2MetadataAutoReload"
            i18nFileName="SAML2MetadataAutoReloadService"
            revisionNumber="1"
            resourceName="saml2MetadataAutoReloadService"
            i18nKey="openam-saml2-metadata-auto-reload-description">

            <Organization>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-metadata-url-backup-map"
                      type="list"
                      syntax="string"
                      uitype="maplist"
                      validator="MapValueValidator"
                      resourceName="urlBackupMap"
                      i18nKey="a101"
                      order="200">
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-execute-time"
                    type="single"
                    syntax="date"
                    i18nKey="a102"
                    order="300"
                    resourceName="executeTime">
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-execute-server-url"
                    type="single_choice"
                    syntax="string"
                    i18nKey="a103"
                    order="400"
                    resourceName="executeServerURL">
                    <ChoiceValues>
                        <ChoiceValuesClassName className="jp.co.osstech.openam.saml2.metadata.ServerURLs"/>
                    </ChoiceValues>
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-target-role"
                    type="single_choice"
                    syntax="string"
                    i18nKey="a104"
                    order="500"
                    resourceName="targetRole">
                    <ChoiceValues>
                        <ChoiceValue i18nKey="a201">ALL</ChoiceValue>
                        <ChoiceValue i18nKey="a202">SP_ONLY</ChoiceValue>
                        <ChoiceValue i18nKey="a203">IDP_ONLY</ChoiceValue>
                        <ChoiceValue i18nKey="a204">NOTHING</ChoiceValue>
                    </ChoiceValues>
                    <DefaultValues>
                        <Value>SP_ONLY</Value>
                    </DefaultValues>
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-include-entities"
                    type="list"
                    syntax="string"
                    i18nKey="a105"
                    order="600"
                    resourceName="includeEntities">
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-exclude-entities"
                    type="list"
                    syntax="string"
                    i18nKey="a106"
                    order="700"
                    resourceName="excludeEntities">
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-allow-create-entities"
                    type="single"
                    syntax="boolean"
                    i18nKey="a109"
                    order="750"
                    resourceName="allowCreateEntities">
                    <BooleanValues>
                        <BooleanTrueValue i18nKey="i18nTrue">true</BooleanTrueValue>
                        <BooleanFalseValue i18nKey="i18nFalse">false</BooleanFalseValue>
                    </BooleanValues>
                    <DefaultValues>
                        <Value>true</Value>
                    </DefaultValues>
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-check-expiration-date"
                    type="single"
                    syntax="boolean"
                    i18nKey="a107"
                    order="800"
                    resourceName="checkExpirationDate">
                    <BooleanValues>
                        <BooleanTrueValue i18nKey="i18nTrue">true</BooleanTrueValue>
                        <BooleanFalseValue i18nKey="i18nFalse">false</BooleanFalseValue>
                    </BooleanValues>
                    <DefaultValues>
                        <Value>true</Value>
                    </DefaultValues>
                </AttributeSchema>
                <AttributeSchema name="openam-saml2-metadata-auto-reload-validate-signature"
                    type="single"
                    syntax="boolean"
                    i18nKey="a108"
                    order="900"
                    resourceName="validateSignature">
                    <BooleanValues>
                        <BooleanTrueValue i18nKey="i18nTrue">true</BooleanTrueValue>
                        <BooleanFalseValue i18nKey="i18nFalse">false</BooleanFalseValue>
                    </BooleanValues>
                    <DefaultValues>
                        <Value>true</Value>
                    </DefaultValues>
                </AttributeSchema>
            </Organization>
        </Schema>
    </Service>
</ServicesConfiguration>
